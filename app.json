{
  "expo": {
    "name": "CaissaPro",
    "slug": "caissa-pro",
    "version": "1.0.0",
    "description": "Système de caisse moderne et intuitif pour restaurants et cafés. Gérez vos tables, commandes, paiements et rapports en toute simplicité.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caissapro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caissapro.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.caissapro.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3B82F6",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3B82F6"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12acada6-df9d-4479-a8d4-19576cff8b93"
      }
    },
    "owner": "noureddineazinag"
  }
}
